{
  "name": "speckify",
  "version": "0.0.0",
  "description": "Bundle an OpenAPI spec, compute its semver bump from the registry's last published version, and publish generated client/server packages.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "speckify": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@redocly/openapi-core": "1.34.3",
    "commander": "13.1.0",
    "semver": "7.7.1",
    "yaml": "2.7.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/node": "22.13.4",
    "@types/semver": "7.5.8",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.20.0",
    "eslint-config-prettier": "10.0.1",
    "globals": "15.15.0",
    "prettier": "3.5.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vitest": "3.0.5"
  },
  "packageManager": "pnpm@9.15.9"
}
