{
  "name": "speckify",
  "version": "0.0.0",
  "description": "Bundle an OpenAPI spec, compute its semver bump from the registry's last published version, and publish generated client/server packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/branchLeft/speckify.git"
  },
  "type": "module",
  "bin": {
    "speckify": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "data",
    "python"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/oasdiff/checksums.json dist/oasdiff/checksums.json && cp src/oasdiff/binary-checksums.json dist/oasdiff/binary-checksums.json && node scripts/copy-runtime-assets.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "22.13.4",
    "commander": "13.1.0",
    "semver": "7.7.1",
    "tar-stream": "3.2.1",
    "typescript": "5.9.3",
    "yaml": "2.7.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/semver": "7.5.8",
    "@types/tar-stream": "3.1.3",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.20.0",
    "eslint-config-prettier": "10.0.1",
    "globals": "15.15.0",
    "prettier": "3.5.1",
    "typescript-eslint": "8.71.0",
    "vitest": "3.0.5"
  },
  "packageManager": "pnpm@9.15.9"
}
