{
  "oasdiffVersion": "1.32.1",
  "entries": [
    {
      "pattern": "components.securitySchemes.*.flows.**.authorizationUrl",
      "actions": ["change", "set", "unset"],
      "classes": ["root"],
      "reason": "an OAuth flow's authorizationUrl change is not reported, whether or not the scheme is in use"
    },
    {
      "pattern": "components.securitySchemes.*.flows.**.scopes.*",
      "actions": ["add", "change", "remove"],
      "classes": ["root"],
      "reason": "a scope added to, changed in or removed from an OAuth flow is not reported, whether or not the scheme is in use"
    },
    {
      "pattern": "components.securitySchemes.*.flows.**.tokenUrl",
      "actions": ["change", "set", "unset"],
      "classes": ["root"],
      "reason": "an OAuth flow's tokenUrl change is not reported, whether or not the scheme is in use"
    },
    {
      "pattern": "paths.*.*.parameters.*.schema.properties.*",
      "actions": ["add"],
      "classes": ["root"],
      "reason": "a property added to an object parameter schema is not reported"
    },
    {
      "pattern": "paths.*.*.parameters.*.schema.required",
      "actions": ["add"],
      "classes": ["root"],
      "reason": "a property becoming required in an object parameter schema is not reported"
    },
    {
      "pattern": "paths.*.*.parameters.*.schema.x-*",
      "actions": ["change"],
      "classes": ["root"],
      "reason": "a generic extension edit on a parameter schema is not reported"
    },
    {
      "pattern": "paths.*.*.parameters.*.x-*",
      "actions": ["add", "change", "remove"],
      "classes": ["root"],
      "reason": "only specific parameter extensions are judged; a generic extension edit is not reported"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.deprecated",
      "actions": ["set", "unset"],
      "classes": ["root", "root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "deprecated is only judged on a named property, and not inside an allOf branch"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.discriminator",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "a discriminator inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.else",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "if/then/else inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.enum",
      "actions": ["add"],
      "classes": ["root", "root+allOf"],
      "reason": "values added to the enum of a body schema root are not reported (only nested schemas are walked for enum additions)"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.if",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "if/then/else inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.nullable",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "nullable inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.pattern",
      "actions": ["change", "set", "unset"],
      "classes": ["root", "root+allOf"],
      "reason": "pattern edits on a body schema root are not reported; only nested properties are"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.prefixItems.*",
      "actions": ["add", "remove"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "prefixItems inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.readOnly",
      "actions": ["set", "unset"],
      "classes": ["root", "root+allOf", "subschema", "subschema+allOf"],
      "reason": "readOnly is only judged on a named property"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.then",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "if/then/else inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.writeOnly",
      "actions": ["set", "unset"],
      "classes": ["root", "root+allOf", "subschema", "subschema+allOf"],
      "reason": "writeOnly is only judged on a named property"
    },
    {
      "pattern": "paths.*.*.requestBody.content.*.schema.x-*",
      "actions": ["add", "change"],
      "classes": [
        "root",
        "root+allOf",
        "property",
        "property+allOf",
        "subschema",
        "subschema+allOf"
      ],
      "reason": "only specific extensions (x-extensible-enum, x-stability-level) are judged; a generic extension edit is not reported"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.deprecated",
      "actions": ["set", "unset"],
      "classes": ["root", "root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "deprecated is only judged on a named property, and not inside an allOf branch"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.discriminator",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "a discriminator inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.else",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "if/then/else inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.enum",
      "actions": ["add"],
      "classes": ["root", "root+allOf"],
      "reason": "values added to the enum of a body schema root are not reported (only nested schemas are walked for enum additions)"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.if",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "if/then/else inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.nullable",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "nullable inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.pattern",
      "actions": ["change", "set", "unset"],
      "classes": ["root", "root+allOf"],
      "reason": "pattern edits on a body schema root are not reported; only nested properties are"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.prefixItems.*",
      "actions": ["add", "remove"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "prefixItems inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.readOnly",
      "actions": ["set", "unset"],
      "classes": ["root", "root+allOf", "subschema", "subschema+allOf"],
      "reason": "readOnly is only judged on a named property"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.then",
      "actions": ["set", "unset"],
      "classes": ["root+allOf", "property+allOf", "subschema+allOf"],
      "reason": "if/then/else inside an allOf branch is not reported after flattening"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.writeOnly",
      "actions": ["set", "unset"],
      "classes": ["root", "root+allOf", "subschema", "subschema+allOf"],
      "reason": "writeOnly is only judged on a named property"
    },
    {
      "pattern": "paths.*.*.responses.*.content.*.schema.x-*",
      "actions": ["add", "change"],
      "classes": [
        "root",
        "root+allOf",
        "property",
        "property+allOf",
        "subschema",
        "subschema+allOf"
      ],
      "reason": "only specific extensions (x-extensible-enum, x-stability-level) are judged; a generic extension edit is not reported"
    },
    {
      "pattern": "paths.*.*.x-*",
      "actions": ["add", "change", "remove"],
      "classes": ["root"],
      "reason": "only specific operation extensions (x-stability-level, x-sunset) are judged; a generic extension edit is not reported"
    }
  ]
}
